<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LEO — Premium AI Interface</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;600;700;800;900&family=Orbitron:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --bg-primary: #000000; --bg-secondary: #050505; --bg-tertiary: #0a0a0a;
            --accent-blue: #4a90ff; --accent-purple: #8b5cf6; --accent-cyan: #06b6d4;
            --accent-gold: #d4a574; --text-primary: #ffffff; --text-secondary: #888888;
            --text-tertiary: #555555; --border-subtle: rgba(255,255,255,0.06);
            --border-medium: rgba(255,255,255,0.12);
        }
        html, body { height: 100%; overflow-x: hidden; }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: #000; color: #fff; min-height: 100vh; position: relative;
            overflow-y: auto; scroll-behavior: smooth;
        }
        body::-webkit-scrollbar { width: 6px; }
        body::-webkit-scrollbar-track { background: #000; }
        body::-webkit-scrollbar-thumb { background: linear-gradient(180deg, #1a1a1a, #0a0a0a); border-radius: 3px; }

        /* === BACKGROUNDS === */
        .bg-layer-1 { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #000; z-index: 0; }
        .bg-layer-2 {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(74,144,255,0.08), transparent 60%),
                        radial-gradient(ellipse 60% 50% at 80% 50%, rgba(139,92,246,0.06), transparent 60%),
                        radial-gradient(ellipse 60% 50% at 20% 80%, rgba(6,182,212,0.05), transparent 60%);
            z-index: 1; pointer-events: none;
        }
        .bg-grid {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px),
                              linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);
            background-size: 60px 60px; z-index: 1; pointer-events: none;
            mask-image: radial-gradient(ellipse at center, black 30%, transparent 80%);
        }
        .bg-noise {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%; opacity: 0.025; z-index: 2; pointer-events: none;
            background-image: url("image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
        }
        .stars {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: radial-gradient(1px 1px at 20px 30px, rgba(255,255,255,0.6), transparent),
                              radial-gradient(1px 1px at 40px 70px, rgba(255,255,255,0.4), transparent),
                              radial-gradient(1px 1px at 50px 160px, rgba(255,255,255,0.5), transparent);
            background-repeat: repeat; background-size: 250px 250px; opacity: 0.4; z-index: 2;
            animation: starsMove 200s linear infinite; pointer-events: none;
        }
        @keyframes starsMove { 0% { transform: translateY(0); } 100% { transform: translateY(-250px); } }

        /* === NAVBAR === */
        .navbar {
            position: fixed; top: 0; left: 0; width: 100%; padding: 18px 40px;
            display: flex; justify-content: space-between; align-items: center; z-index: 100;
            background: rgba(0,0,0,0.5); backdrop-filter: blur(20px); border-bottom: 1px solid var(--border-subtle);
        }
        .nav-brand { display: flex; align-items: center; gap: 12px; }
        .nav-logo {
            width: 36px; height: 36px; border-radius: 10px; background: linear-gradient(135deg, #1a1a1a, #000);
            border: 1px solid var(--border-medium); display: flex; align-items: center; justify-content: center;
            position: relative; overflow: hidden;
        }
        .nav-logo::before { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(74,144,255,0.3), transparent 50%); }
        .nav-logo-inner {
            width: 14px; height: 14px; border-radius: 50%; background: radial-gradient(circle at 30% 30%, #fff, #4a90ff);
            box-shadow: 0 0 12px rgba(74,144,255,0.6); position: relative; z-index: 1;
        }
        .nav-name {
            font-family: 'Orbitron', sans-serif; font-size: 18px; font-weight: 700; letter-spacing: 4px;
            background: linear-gradient(135deg, #fff, #888); -webkit-background-clip: text; background-clip: text; color: transparent;
        }
        .nav-links { display: flex; gap: 32px; align-items: center; }
        .nav-link {
            color: var(--text-secondary); text-decoration: none; font-size: 13px; font-weight: 500;
            letter-spacing: 1px; transition: color 0.3s; cursor: pointer;
        }
        .nav-link:hover { color: var(--text-primary); }
        .nav-cta {
            padding: 9px 20px; background: linear-gradient(135deg, #fff, #ddd); color: #000;
            border-radius: 30px; font-size: 12px; font-weight: 600; letter-spacing: 1px;
            cursor: pointer; border: none; transition: all 0.3s;
        }
        .nav-cta:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(255,255,255,0.15); }
        @media (max-width: 768px) { .navbar { padding: 14px 20px; } .nav-links { display: none; } }

        /* === HERO === */
        .hero-section {
            position: relative; z-index: 10; min-height: 100vh; display: flex; flex-direction: column;
            align-items: center; justify-content: center; padding: 120px 20px 60px;
        }
        .badge {
            display: inline-flex; align-items: center; gap: 8px; padding: 6px 16px;
            background: rgba(255,255,255,0.03); border: 1px solid var(--border-medium); border-radius: 20px;
            font-size: 11px; color: var(--text-secondary); letter-spacing: 2px; margin-bottom: 30px; backdrop-filter: blur(10px);
        }
        .badge-dot { width: 6px; height: 6px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 8px #4ade80; animation: pulse 2s infinite; }
        @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
        .logo {
            font-family: 'Orbitron', sans-serif; font-size: clamp(56px, 12vw, 120px); font-weight: 800;
            letter-spacing: clamp(8px, 2vw, 20px); background: linear-gradient(180deg, #fff 0%, #999 50%, #444 100%);
            -webkit-background-clip: text; background-clip: text; color: transparent; margin-bottom: 12px;
            line-height: 1; text-align: center; position: relative;
        }
        .logo::after {
            content: ''; position: absolute; bottom: -20px; left: 50%; transform: translateX(-50%);
            width: 60%; height: 1px; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
        }
        .tagline { font-size: clamp(13px, 1.6vw, 16px); color: var(--text-secondary); letter-spacing: 4px; text-transform: uppercase; margin-bottom: 20px; font-weight: 300; }
        .status {
            font-size: 11px; color: var(--text-tertiary); letter-spacing: 3px; display: flex; align-items: center;
            gap: 10px; justify-content: center; font-family: 'JetBrains Mono', monospace; margin-bottom: 50px;
        }
        .status-dot { width: 6px; height: 6px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 10px #4ade80; animation: pulse 2s infinite; }

        /* === ORB === */
        .orb-container { position: relative; width: 340px; height: 340px; display: flex; align-items: center; justify-content: center; margin: 20px 0; }
        .orb-ring { position: absolute; border-radius: 50%; border: 1px solid rgba(255,255,255,0.05); animation: orbRingRotate 20s linear infinite; }
        .orb-ring-1 { width: 320px; height: 320px; border-top-color: rgba(74,144,255,0.3); }
        .orb-ring-2 { width: 280px; height: 280px; border-right-color: rgba(139,92,246,0.3); animation-direction: reverse; animation-duration: 15s; }
        @keyframes orbRingRotate { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        .orb {
            position: relative; width: 200px; height: 200px; border-radius: 50%;
            background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.9), rgba(180,200,255,0.4) 30%, rgba(74,144,255,0.2) 60%, transparent 80%);
            box-shadow: 0 0 80px rgba(74,144,255,0.4), 0 0 160px rgba(74,144,255,0.15), inset 0 0 60px rgba(74,144,255,0.2);
            animation: orbFloat 6s ease-in-out infinite, orbGlow 3s ease-in-out infinite; z-index: 2;
        }
        .orb::before { content: ''; position: absolute; inset: 10%; border-radius: 50%; background: radial-gradient(circle at 35% 35%, rgba(255,255,255,0.4), transparent 60%); filter: blur(10px); }
        .orb::after {
            content: ''; position: absolute; inset: 0; border-radius: 50%;
            background: conic-gradient(from 0deg, transparent, rgba(74,144,255,0.1), transparent, rgba(139,92,246,0.1), transparent);
            animation: orbConic 8s linear infinite;
        }
        @keyframes orbConic { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        .orb.listening {
            animation: orbPulse 1s ease-in-out infinite;
            background: radial-gradient(circle at 30% 30%, rgba(255,200,200,0.9), rgba(255,100,100,0.5) 30%, rgba(255,50,50,0.2) 60%, transparent);
            box-shadow: 0 0 100px rgba(255,80,80,0.6), 0 0 200px rgba(255,80,80,0.2), inset 0 0 80px rgba(255,80,80,0.3);
        }
        .orb.speaking {
            animation: orbPulse 0.5s ease-in-out infinite;
            background: radial-gradient(circle at 30% 30%, rgba(180,255,200,0.9), rgba(100,255,150,0.5) 30%, rgba(50,200,100,0.2) 60%, transparent);
            box-shadow: 0 0 100px rgba(80,220,120,0.6), 0 0 200px rgba(80,220,120,0.2), inset 0 0 80px rgba(80,220,120,0.3);
        }
        @keyframes orbFloat { 0%, 100% { transform: translateY(0) scale(1); } 50% { transform: translateY(-15px) scale(1.03); } }
        @keyframes orbGlow { 0%, 100% { filter: brightness(1); } 50% { filter: brightness(1.15); } }
        @keyframes orbPulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.1); } }
        .wave { position: absolute; border: 1px solid rgba(74,144,255,0.4); border-radius: 50%; animation: waveExpand 4s ease-out infinite; pointer-events: none; }
        .wave:nth-child(1) { width: 200px; height: 200px; animation-delay: 0s; }
        .wave:nth-child(2) { width: 200px; height: 200px; animation-delay: 1.3s; }
        .wave:nth-child(3) { width: 200px; height: 200px; animation-delay: 2.6s; }
        @keyframes waveExpand { 0% { transform: scale(0.9); opacity: 0.8; } 100% { transform: scale(1.6); opacity: 0; } }
        .waveform {
            position: absolute; bottom: -50px; left: 50%; transform: translateX(-50%);
            display: flex; gap: 4px; align-items: center; height: 40px; opacity: 0; transition: opacity 0.3s;
        }
        .waveform.active { opacity: 1; }
        .wave-bar { width: 3px; background: linear-gradient(to top, rgba(74,144,255,0.8), rgba(180,210,255,0.9)); border-radius: 2px; animation: waveBar 1s ease-in-out infinite; }
        .wave-bar:nth-child(1) { height: 20px; animation-delay: 0s; }
        .wave-bar:nth-child(2) { height: 30px; animation-delay: 0.1s; }
        .wave-bar:nth-child(3) { height: 25px; animation-delay: 0.2s; }
        .wave-bar:nth-child(4) { height: 35px; animation-delay: 0.3s; }
        .wave-bar:nth-child(5) { height: 20px; animation-delay: 0.4s; }
        .wave-bar:nth-child(6) { height: 30px; animation-delay: 0.5s; }
        .wave-bar:nth-child(7) { height: 25px; animation-delay: 0.6s; }
        .wave-bar:nth-child(8) { height: 35px; animation-delay: 0.7s; }
        @keyframes waveBar { 0%, 100% { transform: scaleY(0.4); } 50% { transform: scaleY(1); } }

        /* === TEXT DISPLAY === */
        .text-display { text-align: center; margin: 30px 0; max-width: 700px; width: 100%; padding: 0 20px; }
        .greeting {
            font-size: clamp(28px, 4vw, 40px); font-weight: 200; letter-spacing: 1px; margin-bottom: 8px;
            background: linear-gradient(180deg, #fff, #888); -webkit-background-clip: text; background-clip: text; color: transparent;
        }
        .subtitle { font-size: 15px; color: var(--text-secondary); letter-spacing: 1px; font-weight: 300; }
        .response-text {
            font-size: 17px; line-height: 1.7; margin-top: 24px; padding: 24px 28px;
            background: linear-gradient(135deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
            border-radius: 18px; border: 1px solid var(--border-medium); display: none; text-align: left;
            position: relative; backdrop-filter: blur(20px);
        }
        .response-text::before {
            content: 'LEO'; position: absolute; top: -10px; left: 20px; background: #000; padding: 2px 12px;
            font-family: 'Orbitron', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 3px;
            color: var(--accent-blue); border: 1px solid var(--border-medium); border-radius: 4px;
        }
        .response-text.show { display: block; animation: fadeIn 0.5s ease; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        /* === CONTROLS === */
        .controls { display: flex; gap: 16px; align-items: center; margin-top: 40px; flex-wrap: wrap; justify-content: center; padding: 0 20px; }
        .control-btn {
            width: 56px; height: 56px; border-radius: 50%; border: 1px solid var(--border-medium);
            background: linear-gradient(135deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
            color: #fff; font-size: 22px; cursor: pointer; transition: all 0.3s;
            display: flex; align-items: center; justify-content: center; backdrop-filter: blur(20px); position: relative; overflow: hidden;
        }
        .control-btn::before {
            content: ''; position: absolute; inset: 0; background: radial-gradient(circle at center, rgba(74,144,255,0.2), transparent 70%);
            opacity: 0; transition: opacity 0.3s;
        }
        .control-btn:hover { border-color: rgba(255,255,255,0.3); transform: translateY(-2px); }
        .control-btn:hover::before { opacity: 1; }
        .control-btn.active {
            background: linear-gradient(135deg, rgba(255,80,80,0.3), rgba(255,80,80,0.1));
            border-color: rgba(255,80,80,0.6); animation: recordPulse 1.5s infinite;
        }
        @keyframes recordPulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(255,80,80,0.5); } 50% { box-shadow: 0 0 0 18px rgba(255,80,80,0); } }
        .input-container { position: relative; width: 440px; max-width: 90%; }
        .input-field {
            width: 100%; padding: 16px 56px 16px 26px;
            background: linear-gradient(135deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
            border: 1px solid var(--border-medium); border-radius: 30px; color: #fff; font-size: 15px;
            outline: none; transition: all 0.3s; backdrop-filter: blur(20px); font-family: inherit;
        }
        .input-field:focus { border-color: rgba(74,144,255,0.5); box-shadow: 0 0 0 4px rgba(74,144,255,0.08); }
        .input-field::placeholder { color: rgba(255,255,255,0.35); }
        .send-btn {
            position: absolute; right: 6px; top: 50%; transform: translateY(-50%);
            width: 42px; height: 42px; border-radius: 50%; border: none;
            background: linear-gradient(135deg, #fff, #ddd); color: #000; cursor: pointer;
            transition: all 0.3s; display: flex; align-items: center; justify-content: center; font-size: 22px; font-weight: 700;
        }
        .send-btn:hover { transform: translateY(-50%) scale(1.05); box-shadow: 0 4px 16px rgba(255,255,255,0.2); }

        /* === SECTIONS === */
        .section { position: relative; z-index: 10; padding: 100px 40px; max-width: 1300px; margin: 0 auto; }
        .section-header { text-align: center; margin-bottom: 60px; }
        .section-tag {
            display: inline-block; font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 3px;
            color: var(--accent-blue); margin-bottom: 16px; padding: 5px 14px; border: 1px solid rgba(74,144,255,0.3);
            border-radius: 20px; background: rgba(74,144,255,0.05);
        }
        .section-title {
            font-size: clamp(32px, 5vw, 52px); font-weight: 700; letter-spacing: -1px;
            background: linear-gradient(180deg, #fff, #777); -webkit-background-clip: text; background-clip: text; color: transparent;
            margin-bottom: 16px; line-height: 1.1;
        }
        .section-subtitle { font-size: 16px; color: var(--text-secondary); max-width: 600px; margin: 0 auto; line-height: 1.6; font-weight: 300; }
        .features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
        .feature-card {
            background: linear-gradient(135deg, rgba(255,255,255,0.03), rgba(255,255,255,0.005));
            border: 1px solid var(--border-medium); border-radius: 20px; padding: 32px;
            position: relative; overflow: hidden; transition: all 0.4s; backdrop-filter: blur(20px);
        }
        .feature-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent); }
        .feature-card::after {
            content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%;
            background: radial-gradient(circle at center, rgba(74,144,255,0.08), transparent 50%);
            opacity: 0; transition: opacity 0.4s; pointer-events: none;
        }
        .feature-card:hover { transform: translateY(-4px); border-color: rgba(255,255,255,0.2); }
        .feature-card:hover::after { opacity: 1; }
        .feature-icon {
            width: 52px; height: 52px; border-radius: 14px;
            background: linear-gradient(135deg, rgba(74,144,255,0.15), rgba(139,92,246,0.1));
            border: 1px solid var(--border-medium); display: flex; align-items: center; justify-content: center;
            font-size: 24px; margin-bottom: 20px; position: relative;
        }
        .feature-title { font-size: 19px; font-weight: 600; margin-bottom: 10px; letter-spacing: -0.3px; }
        .feature-desc { font-size: 14px; color: var(--text-secondary); line-height: 1.6; font-weight: 300; }
        .stats-section { padding: 80px 40px; position: relative; z-index: 10; max-width: 1200px; margin: 0 auto; }
        .stats-grid {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1px;
            background: var(--border-medium); border: 1px solid var(--border-medium); border-radius: 20px; overflow: hidden;
        }
        .stat-item { background: linear-gradient(180deg, #050505, #000); padding: 36px 28px; text-align: center; position: relative; transition: background 0.3s; }
        .stat-item:hover { background: linear-gradient(180deg, #0a0a0a, #050505); }
        .stat-number {
            font-family: 'Orbitron', sans-serif; font-size: 42px; font-weight: 700;
            background: linear-gradient(180deg, #fff, #666); -webkit-background-clip: text; background-clip: text; color: transparent; margin-bottom: 8px;
        }
        .stat-label { font-size: 12px; color: var(--text-secondary); letter-spacing: 2px; text-transform: uppercase; font-weight: 500; }
        .capabilities-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; }
        .capability-card {
            background: linear-gradient(135deg, rgba(255,255,255,0.025), transparent); border: 1px solid var(--border-medium);
            border-radius: 18px; padding: 24px; display: flex; gap: 18px; align-items: flex-start; transition: all 0.3s; backdrop-filter: blur(10px);
        }
        .capability-card:hover { background: linear-gradient(135deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01)); border-color: rgba(255,255,255,0.2); transform: translateX(4px); }
        .capability-num { font-family: 'Orbitron', sans-serif; font-size: 24px; font-weight: 700; color: transparent; -webkit-text-stroke: 1px rgba(255,255,255,0.4); min-width: 40px; }
        .capability-content h4 { font-size: 16px; font-weight: 600; margin-bottom: 6px; }
        .capability-content p { font-size: 13px; color: var(--text-secondary); line-height: 1.6; font-weight: 300; }
        .tiers-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
        .tier-card {
            background: linear-gradient(180deg, rgba(255,255,255,0.025), rgba(255,255,255,0.005));
            border: 1px solid var(--border-medium); border-radius: 20px; padding: 36px 28px;
            position: relative; transition: all 0.4s; backdrop-filter: blur(20px);
        }
        .tier-card.featured { background: linear-gradient(180deg, rgba(74,144,255,0.08), rgba(139,92,246,0.04)); border-color: rgba(74,144,255,0.3); transform: scale(1.03); }
        .tier-card.featured::before {
            content: 'POPULAR'; position: absolute; top: 14px; right: 14px; font-size: 9px; font-family: 'JetBrains Mono', monospace;
            letter-spacing: 2px; color: var(--accent-blue); padding: 3px 10px; background: rgba(74,144,255,0.15);
            border: 1px solid rgba(74,144,255,0.3); border-radius: 10px;
        }
        .tier-card:hover { transform: translateY(-4px); border-color: rgba(255,255,255,0.2); }
        .tier-card.featured:hover { transform: scale(1.03) translateY(-4px); }
        .tier-name { font-family: 'Orbitron', sans-serif; font-size: 14px; letter-spacing: 4px; color: var(--text-secondary); margin-bottom: 16px; }
        .tier-price { font-size: 42px; font-weight: 700; margin-bottom: 4px; letter-spacing: -1px; }
        .tier-price span { font-size: 14px; color: var(--text-secondary); font-weight: 400; }
        .tier-desc { font-size: 13px; color: var(--text-secondary); margin-bottom: 24px; font-weight: 300; }
        .tier-features { list-style: none; margin-bottom: 28px; }
        .tier-features li {
            font-size: 13px; color: var(--text-secondary); padding: 8px 0; border-bottom: 1px solid var(--border-subtle);
            display: flex; align-items: center; gap: 10px; font-weight: 300;
        }
        .tier-features li::before { content: '✓'; color: var(--accent-blue); font-weight: 700; }
        .tier-btn {
            width: 100%; padding: 12px; background: rgba(255,255,255,0.05); border: 1px solid var(--border-medium);
            border-radius: 30px; color: #fff; font-size: 13px; font-weight: 600; letter-spacing: 1px; cursor: pointer; transition: all 0.3s;
        }
        .tier-card.featured .tier-btn { background: linear-gradient(135deg, #fff, #ddd); color: #000; border-color: transparent; }
        .tier-btn:hover { background: rgba(255,255,255,0.1); }
        .tier-card.featured .tier-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(255,255,255,0.15); }
        .testimonials-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
        .testimonial {

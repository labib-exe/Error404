        function displayResponse(text) {
            const responseEl = document.getElementById('responseText');
            responseEl.textContent = text;
            responseEl.classList.add('show');
            setTimeout(() => { responseEl.classList.remove('show'); }, 15000);
        }

        function speak(text) {
            if (!('speechSynthesis' in window)) return;
            window.speechSynthesis.cancel();
            const utterance = new SpeechSynthesisUtterance(text.replace(/[^\u0980-\u09FF\s\.\,\?\!a-zA-Z0-9]/g, ''));
            utterance.lang = 'bn-BD'; utterance.rate = 0.95;
            utterance.onstart = () => { isSpeaking = true; document.getElementById('orb').classList.add('speaking'); };
            utterance.onend = () => { isSpeaking = false; document.getElementById('orb').classList.remove('speaking'); };
            window.speechSynthesis.speak(utterance);
        }

        function clearChat() {
            document.getElementById('responseText').classList.remove('show');
            document.getElementById('userInput').value = '';
            document.getElementById('subtitle').textContent = 'How can I help you today?';
        }

        // === MODAL FUNCTIONS ===
